[Desktop Entry]
Type=Service
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/vnd.debian.binary-package;application/x-rpm;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;
Actions=termaInstall
X-KDE-Priority=TopLevel

[Desktop Action termaInstall]
Name=Install with Terma
Name[de]=Mit Terma installieren
Icon=terma
Exec=terma %f
